    <script>
        mermaid.initialize({
            startOnLoad: true,
            theme: 'base',
            themeVariables: {
                primaryColor: '#fff',
                primaryBorderColor: '#aaa',
                primaryTextColor: '#000',
                lineColor: '#555'
            },
            flowchart: {
                htmlLabels: false,
                curve: 'monotoneY',
                defaultRenderer: 'elk'
            }
        });
    </script>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f8f9fa;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }
        h1 {
            color: #0d47a1;
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #e3e3e3;
            padding-bottom: 15px;
        }
        .mermaid {
            overflow: auto;
        }
        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
            padding: 20px;
            background: #f0f4f8;
            border-radius: 8px;
        }
        .legend-item {
            display: flex;
            align-items: center;
            margin-right: 20px;
        }
        .legend-color {
            width: 20px;
            height: 20px;
            margin-right: 8px;
            border-radius: 4px;
            border: 1px solid #ccc;
        }
        .description {
            margin-top: 30px;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 8px;
            border-left: 4px solid #42a5f5;
        }
    </style><style class="darkreader darkreader--sync" media="screen"></style>
