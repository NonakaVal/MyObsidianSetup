		{"id":"e_roteiro_gravacao","fromNode":"grp_roteiro","fromSide":"bottom","toNode":"grp_gravacao","toSide":"top","label":"leitura em voz alta ok"},
		{"id":"e_gravacao_edicao","fromNode":"grp_gravacao","fromSide":"bottom","toNode":"grp_edicao","toSide":"top","label":"takes transferidos"},
		{"id":"e_edicao_publicacao","fromNode":"grp_edicao","fromSide":"bottom","toNode":"grp_publicacao","toSide":"top","label":"arquivo aprovado"},
