filters:
  and:
    - file.inFolder("09 Focus Areas")
    - file.ext == "md"
    - '!file.inFolder("08 Focus Areas/Youtube-Videos")'
formulas:
  Parent Folder: file.folder.split("/")[-1]
  folder_list: |-
    [
      ["08 Focus Areas/Autoconhecimento",  "🪞"],
      ["08 Focus Areas",                   "🎯"],
      ["/",                                "🏡"]
    ]
  check_folders: formula.folder_list.filter(file.folder.contains(value[0]))[0]
  ✨: if(formula.check_folders, formula.check_folders[1], "")
  M.time: file.mtime.relative()
properties:
  file.name:
    displayName: Note
  file.backlinks:
    displayName: Inlinks
views:
  - type: table
    name: All
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - formula.M.time
    sort:
      - property: formula.M.time
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 280
      formula.M.time: 160
  - type: cards
    name: Cards
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
    cardSize: 200
  - type: table
    name: Autoconhecimento
    filters:
      and:
        - file.inFolder("08 Focus Areas/Autoconhecimento")
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - formula.M.time
    sort:
      - property: formula.M.time
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 280
  - type: table
    name: Most Linked
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - file.folder
    sort:
      - property: file.backlinks
        direction: DESC
    limit: 30
    columnSize:
      formula.✨: 23
      file.name: 280
