filters:
  and:
    - file.inFolder("08 Ongoing/NonakaLab Channel")
    - status != "done"
formulas:
  mod: file.mtime.relative()
  score: rank * chance
views:
  - type: table
    name: ++ score (status)
    filters:
      and:
        - status != "posted"
        - '!file.tags.contains("list")'
    groupBy:
      property: status
      direction: DESC
    order:
      - created
      - file.name
      - chance
      - formula.score
      - rank
      - formula.mod
      - tags
      - file.links
      - file.backlinks
      - file.embeds
    sort:
      - property: formula.score
        direction: DESC
      - property: created
        direction: DESC
    columnSize:
      note.created: 152
      file.name: 320
      note.chance: 84
      note.rank: 87
      formula.mod: 231
      note.tags: 201
  - type: table
    name: status view
    filters:
      and:
        - '!file.tags.contains("task")'
    groupBy:
      property: status
      direction: DESC
    order:
      - created
      - file.name
      - summary
      - rank
      - chance
      - formula.score
      - status
      - formula.mod
      - file.folder
    sort:
      - property: formula.score
        direction: DESC
    columnSize:
      note.chance: 84
      note.rank: 81
      note.created: 182
      note.status: 131
      formula.mod: 161
      note.summary: 315
  - type: table
    name: ++ score
    filters:
      and:
        - status != "posted"
        - '!file.tags.contains("list")'
        - status != "done"
    order:
      - rank
      - chance
      - file.name
      - status
      - formula.score
      - summary
      - formula.mod
      - created
      - file.folder
    sort:
      - property: status
        direction: DESC
      - property: formula.score
        direction: DESC
    columnSize:
      note.status: 131
      note.rank: 103
      note.chance: 84
      note.summary: 315
      formula.mod: 161
      note.created: 182
  - type: tasknotesKanban
    name: View
    groupBy:
      property: status
      direction: DESC
    sort: []
    columnOrder: '{"note.status":["open","idea","in-progress","archived","none","done"]}'
    hideEmptyColumns: true
    enableSearch: true
  - type: tasknotesTaskList
    name: List view
    groupBy:
      property: status
      direction: ASC
    sort: []
    columnOrder: '{"note.status":["open","idea","in-progress","archived","none","done"]}'
    hideEmptyColumns: true
    enableSearch: true
    markers: bullet
