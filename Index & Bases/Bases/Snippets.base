filters:
  and:
    - file.inFolder("Knowlegde/01 Resources/Snippets")
views:
  - type: table
    name: Tabela
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - dateCreated
      - file.name
      - title
      - tags
    columnSize:
      file.name: 234
      note.title: 237
