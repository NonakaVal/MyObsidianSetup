filters:
  and:
    - file.inFolder("Knowlegde")
    - file.ext == "md"
formulas:
  Parent Folder: file.folder.split("/")[-1]
  folder_list: |-
    [
      ["Knowlegde/33 Concept/Dev & TI",                    "💻"],
      ["Knowlegde/33 Concept/marketing",                   "📣"],
      ["Knowlegde/33 Concept",                             "💡"],
      ["Knowlegde/35 Recources/PROMPTS-LLM",               "📢"],
      ["Knowlegde/35 Recources/NotebookLM-Notes",          "🗒️"],
      ["Knowlegde/35 Recources/PDFs",                      "📓"],
      ["Knowlegde/35 Recources",                           "🗂️"],
      ["Knowlegde/36 Books",                               "📚"],
      ["Knowlegde/37 Music & Games & Movies",              "🎬"],
      ["Knowlegde/31 Dots",                                "•"],
      ["Knowlegde",                                        "🧠"],
      ["+",                                                "✨"],
      ["/",                                                "🏡"]
    ]
  check_folders: formula.folder_list.filter(file.folder.contains(value[0]))[0]
  Folder Group: if(formula.check_folders, formula.check_folders[0], "")
  ✨: if(formula.check_folders, formula.check_folders[1], "")
  M.time: file.mtime.relative()
  C.Time: file.ctime.relative()
properties:
  file.name:
    displayName: Note
  file.backlinks:
    displayName: Inlinks
  file.links:
    displayName: Outlinks
views:
  - type: table
    name: All
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
      - file.links
      - file.backlinks
      - formula.M.time
    sort:
      - property: formula.✨
        direction: ASC
      - property: file.name
        direction: ASC
      - property: file.links
        direction: ASC
      - property: file.backlinks
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 419
      file.backlinks: 601
      formula.M.time: 160
  - type: table
    name: 31 Dots
    filters:
      and:
        - file.inFolder("Knowlegde/31 Dots")
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - file.links
      - formula.M.time
    sort:
      - property: file.name
        direction: ASC
      - property: file.backlinks
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 280
      formula.M.time: 160
  - type: table
    name: 33 Concepts
    filters:
      and:
        - subject.contains(link("hub-mkt"))
    groupBy:
      property: subject
      direction: ASC
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - file.links
      - formula.M.time
      - file.path
    sort:
      - property: file.name
        direction: DESC
      - property: file.backlinks
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 421
      file.backlinks: 601
      formula.M.time: 160
  - type: table
    name: 36 Books
    filters:
      and:
        - file.inFolder("Knowlegde/36 Books")
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - file.links
      - formula.M.time
    sort:
      - property: file.name
        direction: ASC
      - property: created
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 280
      formula.M.time: 160
  - type: table
    name: 37 Media
    filters:
      and:
        - file.inFolder("Knowlegde/37 Music & Games & Movies")
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - formula.M.time
    sort:
      - property: file.name
        direction: ASC
      - property: created
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 280
      formula.M.time: 160
  - type: table
    name: 35 Resources
    filters:
      and:
        - file.inFolder("Knowlegde/35 Recources")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
      - formula.M.time
    sort:
      - property: formula.M.time
        direction: DESC
    columnSize:
      formula.✨: 120
      file.name: 280
      formula.M.time: 160
  - type: table
    name: Most Linked
    order:
      - formula.✨
      - file.name
      - file.backlinks
      - file.links
      - file.folder
    sort:
      - property: file.backlinks
        direction: DESC
    limit: 50
    columnSize:
      formula.✨: 23
      file.name: 280
