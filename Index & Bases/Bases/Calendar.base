filters:
  and:
    - file.inFolder("Calendar & Review")
    - file.ext == "md"
formulas:
  folder_list: |-
    [
      ["Calendar & Review/Daily Notes",    "📅"],
      ["Calendar & Review/Weekly Notes",   "📆"],
      ["Calendar & Review/Monthly Notes",  "🗓️"],
      ["Calendar & Review/Journaling",     "📓"],
      ["Calendar & Review",                "📅"],
      ["/",                                "🏡"]
    ]
  check_folders: formula.folder_list.filter(file.folder.contains(value[0]))[0]
  ✨: if(formula.check_folders, formula.check_folders[1], "")
  M.time: file.mtime.relative()
  C.Time: file.ctime.relative()
  Week: file.ctime.weekYear
properties:
  file.name:
    displayName: Note
views:
  - type: table
    name: All
    groupBy:
      property: file.folder
      direction: DESC
    order:
      - formula.✨
      - file.name
      - created
      - formula.M.time
    sort:
      - property: created
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 220
      formula.M.time: 160
  - type: table
    name: Daily Notes
    filters:
      and:
        - file.inFolder("Calendar & Review/Daily Notes")
    order:
      - formula.✨
      - file.name
      - formula.M.time
    sort:
      - property: created
        direction: ASC
    limit: 90
    columnSize:
      formula.✨: 23
      file.name: 180
      formula.M.time: 160
  - type: table
    name: Weekly Notes
    filters:
      and:
        - file.inFolder("Calendar & Review/Weekly Notes")
    order:
      - formula.✨
      - file.name
      - created
      - formula.M.time
    sort:
      - property: created
        direction: DESC
    limit: 52
    columnSize:
      formula.✨: 23
      file.name: 220
      formula.M.time: 160
  - type: table
    name: Monthly Notes
    filters:
      and:
        - file.inFolder("Calendar & Review/Monthly Notes")
    order:
      - formula.✨
      - file.name
      - created
      - formula.M.time
    sort:
      - property: created
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 220
      formula.M.time: 160
  - type: table
    name: Journaling
    filters:
      and:
        - file.inFolder("Calendar & Review/Journaling")
    order:
      - formula.✨
      - file.name
      - created
      - formula.M.time
    sort:
      - property: created
        direction: DESC
    limit: 60
    columnSize:
      formula.✨: 23
      file.name: 220
      formula.M.time: 160
