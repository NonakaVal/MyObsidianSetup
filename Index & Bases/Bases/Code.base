filters:
  or:
    - file.inFolder("00 Code")
    - file.inFolder("01 Snippets")
formulas:
  Parent Folder: file.folder.split("/")[-1]
  folder_list: |-
    [
      ["01 Snippets/blender",                          "🎨"],
      ["01 Snippets/bash commands",                    "🖥️"],
      ["01 Snippets/Templaper Snippets",               "📋"],
      ["01 Snippets/Python the Movie",                 "🐍"],
      ["01 Snippets/Pandas Wag Collectors Products",   "🐼"],
      ["01 Snippets/yt-dlp",                           "▶️"],
      ["01 Snippets/gallery-controll",                 "🖼️"],
      ["01 Snippets/_ungrouped",                       "📎"],
      ["01 Snippets",                                  "✂️"],
      ["00 Code/Projects",                             "🚀"],
      ["00 Code",                                      "💻"],
      ["/",                                            "🏡"]
    ]
  check_folders: formula.folder_list.filter(file.folder.contains(value[0]))[0]
  ✨: if(formula.check_folders, formula.check_folders[1], "")
  M.time: file.mtime.relative()
  Sem título: ""
properties:
  file.name:
    displayName: File
views:
  - type: table
    name: Snippets
    filters:
      and:
        - file.inFolder("01 Snippets")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
      - file.folder
      - file.size
      - formula.M.time
    sort:
      - property: tags
        direction: ASC
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      formula.✨: 23
      file.name: 300
      file.folder: 323
      file.size: 185
      formula.M.time: 160
  - type: table
    name: All
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
      - formula.M.time
    sort:
      - property: formula.M.time
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 300
      formula.M.time: 160
  - type: cards
    name: Cards
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
    sort:
      - property: file.name
        direction: ASC
    cardSize: 180
  - type: table
    name: Projects
    filters:
      and:
        - file.inFolder("00 Code")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.✨
      - file.name
      - formula.M.time
    sort:
      - property: formula.M.time
        direction: DESC
    columnSize:
      formula.✨: 23
      file.name: 300
  - type: table
    name: Bash
    filters:
      and:
        - file.inFolder("01 Snippets/bash commands")
    order:
      - formula.✨
      - file.name
      - formula.M.time
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      formula.✨: 23
      file.name: 300
