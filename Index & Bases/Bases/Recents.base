      - formula.Parent Folder
      - collections
      - up
      - related
    sort:
      - property: file.name
        direction: DESC
      - property: file.mtime
        direction: DESC
      - property: created
        direction: DESC
    limit: 77
    columnSize:
      formula.✨: 23
      file.name: 244
