filters:
  and:
    - file.inFolder("X")
formulas:
  mT: file.mtime.relative()
  MTime: file.mtime.relative()
views:
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
  - type: table
    name: Assets
    filters:
      and:
        - file.inFolder("X/Assets")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.mT
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.banner
    columnSize:
      formula.mT: 229
  - type: table
    name: Scripts
    filters:
      and:
        - '!file.inFolder("X/Scripts/bin")'
        - '!file.inFolder("X/Scripts/lib")'
        - file.inFolder("X/Scripts")
        - file.ext != "cfg"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.MTime
      - file.name
      - file.size
    sort:
      - property: file.name
        direction: ASC
    image: note.banner
    columnSize:
      formula.MTime: 279
      file.size: 212
  - type: table
    name: Csssnippets
    filters:
      and:
        - file.inFolder("X/Assets/Obsidian-CSS-Snippets-Collection/Snippets")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - formula.mT
      - file.name
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      formula.mT: 229
