formulas:
  relative: file.mtime.relative()
views:
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - created
      - file.name
      - formula.relative
      - file.folder
      - file.backlinks
      - file.links
    sort:
      - property: created
        direction: ASC
    columnSize:
      note.created: 175
      file.folder: 238
      note.tags: 203
  - type: table
    name: +
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.backlinks
      - file.links
      - formula.relative
    sort:
      - property: created
        direction: ASC
    columnSize:
      note.created: 175
      file.links: 335
  - type: table
    name: Daily Notes
    filters:
      and:
        - file.path.contains("Calendar & Review/Daily Notes")
    order:
      - file.name
      - file.size
      - daily-mood
      - file.links
      - file.backlinks
      - file.embeds
      - file.tags
      - formula.relative
      - week
      - pomodoros
    sort:
      - property: file.size
        direction: DESC
      - property: week
        direction: ASC
      - property: file.embeds
        direction: DESC
      - property: file.folder
        direction: DESC
    columnSize:
      file.links: 98
      file.backlinks: 96
      file.embeds: 114
      file.tags: 146
      formula.relative: 136
  - type: table
    name: Daily Notes 2
    filters:
      and:
        - file.path.contains("Calendar & Review/Daily Notes")
    order:
      - file.name
      - file.size
      - daily-mood
      - file.links
      - file.backlinks
      - file.embeds
      - file.tags
      - formula.relative
      - week
      - pomodoros
    sort:
      - property: file.size
        direction: DESC
      - property: week
        direction: ASC
      - property: file.embeds
        direction: DESC
      - property: file.folder
        direction: DESC
    columnSize:
      file.links: 98
      file.backlinks: 96
      file.embeds: 114
      file.tags: 146
      formula.relative: 136
